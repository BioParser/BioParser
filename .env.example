# docker compose preference CPU or GPU, logs, and optional HTTPS reverse proxy (Traefik)
COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml:docker-compose.logging.yml
# COMPOSE_FILE=docker-compose.yml:docker-compose.cpu.yml:docker-compose.logging.yml
# Add :docker-compose.traefik.yml to COMPOSE_FILE to enable encrypted HTTPS via Traefik.

# ──────────────────────────────────────────────
# Traefik HTTPS Reverse Proxy (docker-compose.traefik.yml)
# ──────────────────────────────────────────────

# Host interface to bind Traefik to (default 127.0.0.1 for loopback only).
# Set to 0.0.0.0 to expose Traefik to the local network (LAN).
TRAEFIK_BIND_ADDRESS=127.0.0.1
# Host port for HTTPS (HTTP is disabled to prevent plaintext credential leaks)
TRAEFIK_HTTPS_PORT=443
TRAEFIK_LOG_LEVEL=INFO
# Required with docker-compose.traefik.yml: the Basic Auth users file. The repository ships
# no users and no default password. Make the file as docker/traefik/users.example shows,
# then set for example TRAEFIK_USERS_FILE=./docker/traefik/users
TRAEFIK_USERS_FILE=

# ──────────────────────────────────────────────
# Logs: Loki, Alloy, Grafana (docker-compose.logging.yml)
# ──────────────────────────────────────────────

# Grafana UI on the host: http://localhost:3000, user admin
GRAFANA_PORT=3000
# Required. Grafana reads it only on its first start (empty grafana-data volume);
# after that, change the password in Grafana.
GRAFANA_ADMIN_PASSWORD=
# How long Loki keeps logs (168h = 7 days)
LOKI_RETENTION_PERIOD=168h

# ──────────────────────────────────────────────
# BioParser API
# ──────────────────────────────────────────────

# BioParser FastAPI port
BIOPARSER_PORT=8080

# Shared API key for authenticating requests to /api/* and /extract.
# Clients must send this key in the X-API-Key request header.
# Must be at least 32 visible ASCII characters (without spaces).
# Generate a key with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# Required unless BIOPARSER_AUTH_DISABLED=true.
BIOPARSER_API_KEY=
# Disable API key authentication for local development only (default false).
# BIOPARSER_AUTH_DISABLED=false

# Levels: DEBUG, INFO, WARNING, ERROR or CRITICAL
BIOPARSER_LOG_LEVEL=INFO

# Readiness checks
BIOPARSER_DEPENDENCY_CHECK_TIMEOUT_SECONDS=1.0
# Example for docker compose: redis://redis:6379/0
BIOPARSER_ARTIFACT_STORAGE_PATH=/var/lib/bioparser/artifacts

# In docker compose use: http://vllm:8000/v1
# For local development without docker use: http://localhost:8000/v1
BIOPARSER_VLLM_BASE_URL=http://localhost:8000/v1

# ──────────────────────────────────────────────
# Redis
# ──────────────────────────────────────────────

REDIS_MAXMEMORY=512mb
REDIS_PORT=6379
# Compose places this in the Redis URL for the API and parser-worker.
# Keep it URL-safe (@, :, /, # and % break the URL). Empty means no auth.
REDIS_PASSWORD=""

BIOPARSER_REDIS_URL=redis://redis:6379/0
BIOPARSER_REDIS_TIMEOUT_SECONDS=5.0

# Parser worker (`python -m bioparser.worker.parse`).
# It also reads BIOPARSER_REDIS_URL above and BIOPARSER_ARTIFACT_STORAGE_PATH.
# Required. Queue the worker consumes parse jobs from. Producers must use the same name.
BIOPARSER_PARSE_QUEUE_NAME=parse
# Required. Queue the parser worker wakes extraction on, and the extractor consumes.
BIOPARSER_EXTRACT_QUEUE_NAME=extract
# Optional. Limit for one parse, in seconds. Default 1800 (30 minutes), at most 3600
# (mineru-api's longest wait). The queue's own default is 10 minutes, too short for MinerU on CPU.
# BIOPARSER_PARSE_TIME_LIMIT_SECONDS=1800
# Optional. Retries after a failed attempt. Default 3.
# BIOPARSER_PARSE_MAX_RETRIES=3

# Extractor worker (`python -m bioparser.worker.extract`).
# Compose points BIOPARSER_VLLM_BASE_URL at the vllm service. The model is not in the image.
# It also reads BIOPARSER_REDIS_URL, BIOPARSER_ARTIFACT_STORAGE_PATH, and
# BIOPARSER_EXTRACT_QUEUE_NAME above.
# Optional. Limit for one extraction, in seconds. Default 600 (10 minutes).
# BIOPARSER_EXTRACT_TIME_LIMIT_SECONDS=600
# Optional. Retries after a failed attempt. Default 3.
# BIOPARSER_EXTRACT_MAX_RETRIES=3

# GET /health for the parser and extractor liveness probes. Default 8081.
# Each container has its own port, so both can use 8081.
# BIOPARSER_LIVENESS_PORT=8081

# ──────────────────────────────────────────────
# vLLM
# ──────────────────────────────────────────────

# Model served by vLLM
#
# e.g. if we want the 2-bit Qwen3.8 model optimized by unsloth
#      from https://huggingface.co/unsloth/Qwen3.8-27B-GGUF
#
#    unsloth/Qwen3.8-27B-GGUF:UD-IQ2_XXS  (7.27 GB)
#    unsloth/Qwen3.5-4B-GGUF:UD-IQ2_XXS  (1.52 GB (older, but smaller for testing))

VLLM_MODEL=Qwen/Qwen3-0.6B
VLLM_PORT=8000
VLLM_GPU_FRACTION=0.45
# HugginFace token (needed to download pretrained models)
HF_TOKEN=

# ──────────────────────────────────────────────
# mineru
# ──────────────────────────────────────────────

# Read by the API and the parser worker. Compose sets it for both; the host scripts
# (pdf-parse, pdf-view) default to http://127.0.0.1:8001, see docs/parser.md.
BIOPARSER_MINERU_BASE_URL=http://mineru:8000
# API only (POST /extract): how long it waits for MinerU to parse one PDF, time queued
# behind other parses included. At most 3600.
BIOPARSER_MINERU_TIMEOUT_SECONDS=900
# Parse quality: basic (CPU stack default), standard (GPU stack default) or advanced (GPU).
# The service must serve it; see docs/parser.md.
# BIOPARSER_MINERU_TIER=standard
# Parse jobs the mineru service runs at once (default 1); more wait in its queue. Each running
# job needs its own memory: raise mineru's mem_limit in docker-compose.cpu.yml or .gpu.yml with it.
# MINERU_API_CONCURRENCY=1

# vLLM runs with no auth by default: "EMPTY" 
# Set this if vLLM is started with --api-key.
BIOPARSER_VLLM_API_KEY=EMPTY
