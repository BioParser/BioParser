#!/bin/sh
# Wrapper for the local Compose stack with the hot-reload overlay.
#
#   bash bioparser-compose up
#   bash bioparser-compose down
#
# Port 8080 still serves the UI that was built into the API image. That copy
# does not pick up frontend edits. Open http://localhost:5173/ui/ for UI work.
#
# Appends :docker-compose.dev.yml to COMPOSE_FILE for this run only. A value
# already exported in the shell wins. Otherwise the last COMPOSE_FILE= line in
# .env wins, including an "export " prefix, and a trailing " # comment" is
# dropped. Does not edit .env. GPU or CPU and logging stay whatever that
# value already selects. Every argument is passed through to `docker compose`.

set -eu

cd "$(CDPATH= cd -- "$(dirname "$0")" && pwd)"

if [ $# -eq 0 ]; then
  echo "usage: bash bioparser-compose [docker compose arguments...]" >&2
  exit 2
fi

# Compose strips one matched pair of quotes and ignores the rest of the line.
strip_compose_value() {
  value=$(printf '%s' "$1" | sed 's/^[[:space:]]*//')
  case $value in
    \"*)
      value=${value#\"}
      value=${value%%\"*}
      ;;
    \'*)
      value=${value#\'}
      value=${value%%\'*}
      ;;
    *)
      value=$(printf '%s' "$value" | sed 's/[[:space:]]#.*$//;s/[[:space:]]*$//')
      ;;
  esac
  printf '%s' "$value"
}

if [ -n "${COMPOSE_FILE+x}" ]; then
  compose_file=$COMPOSE_FILE
else
  if [ ! -f .env ]; then
    echo "bioparser-compose: .env is missing (copy .env.example to .env)" >&2
    exit 1
  fi

  compose_file=
  while IFS= read -r line || [ -n "$line" ]; do
    line=$(printf '%s' "$line" | tr -d '\r' | sed 's/^[[:space:]]*//')
    case $line in
      '' | \#*) continue ;;
      export\ *)
        line=${line#export }
        line=$(printf '%s' "$line" | sed 's/^[[:space:]]*//')
        ;;
    esac
    case $line in
      COMPOSE_FILE=*) compose_file=$(strip_compose_value "${line#COMPOSE_FILE=}") ;;
    esac
  done < .env
fi

if [ -z "$compose_file" ]; then
  echo "bioparser-compose: COMPOSE_FILE is not set in .env" >&2
  exit 1
fi

case ":$compose_file:" in
  *:docker-compose.dev.yml:*) ;;
  *) compose_file=$compose_file:docker-compose.dev.yml ;;
esac

export COMPOSE_FILE=$compose_file

exec docker compose "$@"
